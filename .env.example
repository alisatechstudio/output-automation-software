# ==============================================================================
# Output Automation - Environment Configuration
# Stage 2: Google Drive Folder -> Facebook / YouTube / TikTok / Telegram
# ==============================================================================

# Server
PORT=3002
NODE_ENV=development

# MongoDB (Shared with Input Automation for state synchronization)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=news_automation

# Google Cloud OAuth (Read & Delete videos from Google Drive)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REFRESH_TOKEN=1//04your-long-lived-oauth2-refresh-token
GOOGLE_DRIVE_API_KEY=

# Default Source Google Drive Folder ID
GDRIVE_FOLDER_ID=your_source_google_drive_folder_id

# 1. Meta / Facebook Graph API (Facebook Page Reels)
FACEBOOK_PAGE_ID=your-facebook-page-numeric-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-never-expiring-page-access-token
DEFAULT_COMMENT_FORMAT="📌 বিস্তারিত খবর পড়ুন কমেন্টের লিংকে:"

# 2. YouTube Data API v3 (YouTube Shorts)
YOUTUBE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your-google-client-secret
YOUTUBE_REFRESH_TOKEN=1//04your-long-lived-oauth2-refresh-token
YOUTUBE_AUTO_UPLOAD=true

# 3. TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=your-tiktok-user-access-token
TIKTOK_AUTO_UPLOAD=true

# 4. Telegram Bot API (Direct Video Posting to Channel/Group & Admin Alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHANNEL_ID=@your_channel_or_group_id
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_AUTO_UPLOAD=true

# Cleanup & Strategy
DELETE_AFTER_POSTING=true
ORDER_STRATEGY=oldest_first
DATA_DIR=./data

# Internal Background Cron Scheduler (Set to true to run automatically)
CRON_ENABLED=true
CRON_SCHEDULE="0 */2 * * *"

# Dry Run Switch (Simulates uploads without actual network publishing)
DRY_RUN=false
